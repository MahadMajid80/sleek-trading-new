# Leave unset for local development: `npm run dev` starts an embedded PostgreSQL on localhost:5433.
# Set to use another Postgres server, e.g. Neon: postgres://user:password@host/db?sslmode=require
DATABASE_URL=

# Where uploaded documents and receipts are stored (local disk). Defaults to ./.data/uploads
STORAGE_DIR=

# Platform billing (dealerships pay the platform). Leave both unset to use the built-in sandbox, which simulates
# checkout, charges, renewals and webhooks locally. Use test keys (sk_test_…) until you're ready to take real payments.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint pointing at /api/webhooks/stripe (locally: `stripe listen --forward-to localhost:3100/api/webhooks/stripe`)
STRIPE_WEBHOOK_SECRET=
# Public base URL used for Stripe Checkout/Portal redirects. Defaults to the request's origin.
APP_URL=
